# ==============================================================================
# AURION • Atelier Vérité — Apache Root Configuration
# Automatically routes all visitors to the compiled production React app in /dist/
# Direct Admin Access via /admin or /admin/
# Preserves direct access to PHP REST API (/api/) and uploads (/uploads/)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization header to PHP
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Direct Admin Panel Access: /admin and /admin/* map directly to /api/admin/*
  RewriteRule ^admin$ /admin/ [R=301,L]
  RewriteRule ^admin/$ api/admin/index.php [L]
  RewriteRule ^admin/(.*)$ api/admin/$1 [L]

  # 2. Allow direct access to PHP REST API and uploaded media
  RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
  RewriteRule ^ - [L]

  # 3. Route /assets/* directly to dist/assets/*
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 4. Serve dist/index.html for root requests
  RewriteRule ^$ dist/index.html [L]

  # 5. If requested resource is an existing file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. Route all React Router multipage paths (/work, /services, /contact, etc.) to dist/index.html
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^.*$ dist/index.html [L]

  # Fallback to index.html if dist is absent
  RewriteRule ^.*$ index.html [L]
</IfModule>

# Security: Disable directory browsing
Options -Indexes

# Security: Block access to hidden files (.env, .git, .htaccess) and config files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|config|fla|inc|ini|log|psd|sh|sql|sw[op]|env.*))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# MIME types and caching optimizations for luxury imagery and web fonts
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
