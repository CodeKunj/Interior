# ==============================================================================
# AURION • Atelier Vérité Studio — Environment Configuration
# Copy this file to .env and customize with your live cPanel / hosting details.
# ==============================================================================

# Application Environment (production / local)
APP_NAME="AURION • Atelier Vérité Interiors"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database Connection (cPanel MySQL / phpMyAdmin)
# On cPanel, typical database name is like: cpaneluser_atelier
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atelier_interiors
DB_USER=root
DB_PASS=

# Studio CMS Admin Credentials (Override default login)
ADMIN_USER=admin
ADMIN_PASS=atelier2026Password!

# Studio Inquiry Notifications
MAIL_TO=concierge@ateliervérité.com
MAIL_FROM=no-reply@ateliervérité.com
MAIL_FROM_NAME="Atelier Vérité Studio Concierge"
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=587

# Allowed CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
